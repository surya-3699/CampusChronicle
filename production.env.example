# Set in the server process environment. This file is a template, not auto-loaded.
APP_ENV=production
APP_URL=https://campus.example.edu/CampusChronicle
APP_TIMEZONE=Asia/Kolkata
APP_MAINTENANCE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_chronicle
DB_USER=campus_app
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CC_AUTO_MIGRATE=0
# Absolute path outside the document root; writable only by the PHP service account.
CC_STORAGE_PATH=/var/lib/campus-chronicle
# Keep provider values empty to disable the corresponding button.
GOOGLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://campus.example.edu/CampusChronicle/index.php?page=linkedin-callback

# --- Optional: scaling / request gateway (see docs/SCALING.md) ---
# GATEWAY_ENABLED=1        set 0 to switch the gateway off
# GATEWAY_MAX_ACTIVE=      concurrent app executions (auto-sized from memory in the Docker image)
# GATEWAY_RESERVED=        slots held back for admin/sign-in/POST traffic (default 25%)
# GATEWAY_QUEUE_MS=1500    how long a public request may wait for a slot before a 503
# GATEWAY_RATE_GET=600     per-IP GET limit per 10 s (a campus can share one public IP)
# GATEWAY_RATE_POST=120    per-IP POST limit per 10 s
# FPM_MAX_CHILDREN=        PHP-FPM worker pool size (auto-sized in the Docker image)
# DB_PERSISTENT=0          1 = reuse MySQL connections per PHP-FPM worker (keep FPM_MAX_CHILDREN < MySQL max_connections)
# --- Optional: hosted 3D scene instead of the built-in WebGL background ---
# CC_3D_SCENE_URL=https://example.com/embed/your-scene
# --- Security switches (see SECURITY.md) ---
# CC_CSP_MODE=enforce      enforce (default) | report-only (instant rollback if a page misbehaves) | off
# DB_SSL=1                 encrypt + verify the MySQL connection (required for any remote/managed MySQL)
# DB_SSL_CA=               path to the CA certificate (defaults to the system CA bundle)
# --- Administrator two-step verification (TOTP) ---
# CC_APP_KEY=              REQUIRED to enrol: base64 of 32 random bytes. Generate: openssl rand -base64 32
#                          (encrypts authenticator secrets in the database; keep it secret and never change it
#                           without re-enrolling admins)
# CC_ADMIN_2FA_REQUIRED=0  1 = every admin must enrol before reaching the admin area (enable after you enrolled)
# CC_ADMIN_2FA=on          off = emergency switch that disables the 2FA check (use only to recover access)
# --- Contact-form email notifications (optional; messages always appear in Admin > Messages) ---
# RESEND_API_KEY=          from https://resend.com  (verify your domain there to send from your own address)
# MAIL_FROM=Campus Chronicle <no-reply@yourdomain.edu>
# CONTACT_NOTIFY_TO=admin@yourdomain.edu,another@yourdomain.edu
# --- Off-site encrypted backups (see docs/DEPLOYMENT.md) ---
# BACKUP_REMOTE=offsite:my-bucket/campus-chronicle
# BACKUP_PASSPHRASE=       long random secret; keep a copy somewhere safe (cannot restore without it)
# BACKUP_RETENTION_DAYS=30
# RCLONE_CONFIG_OFFSITE_TYPE=s3  RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare  RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...  RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
